{
  "rewrites": [
    {
      "source": "/i",
      "destination": "/api/invite"
    },
    {
      "source": "/i/:name",
      "destination": "/api/invite?name=:name"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
