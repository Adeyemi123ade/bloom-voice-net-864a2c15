<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of ChiChat's is copied by phone backups or phone-to-phone
     transfer: the app's storage holds the sign-in session. Chats are kept
     on the server, so signing in on a new phone brings them back. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
