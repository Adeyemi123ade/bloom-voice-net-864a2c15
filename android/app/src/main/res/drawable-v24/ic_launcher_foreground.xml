<?xml version="1.0" encoding="utf-8"?>
<!--
  ChiChat launcher icon foreground.
  Original splash logo viewBox is 58x58. Android adaptive-icon viewport is 108x108
  with a safe inner zone of ~66x66 centered. We scale the 58-unit logo to ~66 units
  (factor ~1.138) and translate it so its center sits at (54, 54).
  Translation = 54 - (58/2 * 1.138) ≈ 54 - 33 = 21 on both axes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

    <group
        android:scaleX="1.138"
        android:scaleY="1.138"
        android:translateX="21"
        android:translateY="21">

        <!-- Outer green rounded square -->
        <path
            android:fillColor="#22C55E"
            android:pathData="M15,3 L48,3 A12,12 0 0 1 60,15 L60,43 A12,12 0 0 1 48,55 L15,55 A12,12 0 0 1 3,43 L3,15 A12,12 0 0 1 15,3 Z" />

        <!-- Inner dark window -->
        <path
            android:fillColor="#07090C"
            android:pathData="M17,9 L42,9 A8,8 0 0 1 50,17 L50,37 A8,8 0 0 1 42,45 L17,45 A8,8 0 0 1 9,37 L9,17 A8,8 0 0 1 17,9 Z" />

        <!-- Three dots -->
        <path
            android:fillColor="#22C55E"
            android:pathData="M18,23 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
        <path
            android:fillColor="#22C55E"
            android:pathData="M29,23 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
        <path
            android:fillColor="#22C55E"
            android:pathData="M40,23 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />

        <!-- Chat bubble tail -->
        <path
            android:fillColor="#22C55E"
            android:pathData="M14,43 L8,54 L26,47 Z" />

        <!-- Top-right badge: dark ring + green disc -->
        <path
            android:fillColor="#07090C"
            android:pathData="M47,11 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />
        <path
            android:fillColor="#16A34A"
            android:pathData="M47,11 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />

        <!-- Letter "C" inside the badge, drawn as a thick arc -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M47,5.6
                a5.4,5.4 0 1,0 3.82,9.22
                l-1.7,-1.7
                a3,3 0 1,1 0,-7.04
                l1.7,-1.7
                A5.38,5.38 0 0,0 47,5.6 Z" />
    </group>
</vector>
